# HuggingFace token (required — EmbeddingGemma is a gated model)
HUGGINGFACE_TOKEN=your_hf_token
HF_TOKEN=your_hf_token

# OpenAI API key (required for baseline embeddings)
OPENAI_API_KEY=your_openai_key

# Kaggle credentials (required only when downloading MIMIC-III 10k from Kaggle)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key
